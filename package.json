{
  "name": "rbmi-lms",
  "version": "1.0.0",
  "private": true,
  "description": "RBMI Library Management System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local db/seed.ts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/check-db.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.16.0",
    "next": "^16.3.8",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
