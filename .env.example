# Copy to .env.local for local development, or set these in Vercel for production.
# Schema: config/env.ts  |  Consumer: db/client.ts

# development | production | test
NODE_ENV=development

# Only used when running `next dev` directly; Next.js manages its own port.
PORT=8080

# Local development: embedded PGlite, no Postgres required.
#   Must start with "pglite://" to take the PGlite branch in db/client.ts.
# Do NOT use this in production - Vercel's filesystem is read-only, so the
# PGlite branch fails on mkdir and every API route returns 500.
DATABASE_URL=pglite://./data/lms-db

# Production: Supabase TRANSACTION Pooler on port 6543, not the direct connection.
#   Direct host (db.<ref>.supabase.co) is IPv6-only and will not resolve.
#   Port 5432 is the SESSION pooler, capped at 15 concurrent clients project-wide.
#   Vercel runs several function instances in parallel, so 5432 exhausts that cap
#   quickly: requests queue until connect_timeout expires, producing 15-20s pages
#   and intermittent "Application Error" pages. 6543 multiplexes instead.
#   Password must be URL-encoded; Supabase generates characters that break it.
#   Deploy this same value as a Vercel Environment Variable scoped to Production.
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Required in production. Minimum 16 characters. The built-in default is a
# checked-in dev value and must never be used on a deployed environment.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change_me_to_at_least_16_random_characters

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Forces the PGlite branch regardless of DATABASE_URL. Useful for integration
# tests that expect an ephemeral database. Leave unset in production.
# USE_PGLITE=true

# --- E2E only (playwright.config.ts), not read by the running app ---
# Target for `pnpm test:e2e`. Point at a deployed URL to smoke-test production.
# BASE_URL=https://your-app.vercel.app